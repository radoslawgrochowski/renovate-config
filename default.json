{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigests",
    ":automergeLinters",
    ":automergeTesters",
    ":automergeTypes"
  ],
  "reviewers": ["radoslawgrochowski"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on friday"]
  },
  "digest": {
    "enabled": true,
    "automerge": true
  },
  "docker-compose": {
    "enabled": true
  },
  "dockerfile": {
    "enabled": true
  },
  "github-actions": {
    "enabled": true
  },
  "nix": {
    "enabled": true,
    "minimumReleaseAgeBehaviour": "timestamp-optional"
  },
  "npm": {
    "enabled": true
  },
  "minimumReleaseAge": "21 days",
  "packageRules": [
    {
      "description": "Nix: automerge flake.lock maintenance",
      "matchPackageManagers": ["nix"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "automerge": true,
      "prCreation": "immediate"
    },
    {
      "description": "Automerge patch and minor updates for GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge TypeScript updates in devDependencies",
      "matchPackageNames": ["typescript"],
      "matchDepTypes": ["devDependencies"],
      "automerge": true
    },
    {
      "description": "Disable release age for lockfile maintenance",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null
    }
  ]
}
